# The name people type into Darkmatter. Its DNS A/AAAA record must point at
# this server before the first start, so Let's Encrypt can check it.
AXIOND_DOMAIN=chat.example.com
# Where Let's Encrypt writes about the certificate (expiry problems).
AXIOND_ACME_EMAIL=you@example.com
# Leave true for the first start; set false once it works (real certificates
# are rate limited).
AXIOND_ACME_STAGING=true
# The name the apps show.
AXIOND_SITE_NAME=Home
