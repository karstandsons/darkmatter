# Maintainer: Cody Karst <codykarst@gmail.com>
#
# Builds darkmatter from git. Until the repo is published, it builds this
# checkout: run `makepkg -si` in packaging/arch. Set DARKMATTER_GIT to build
# another clone or a URL.
pkgname=darkmatter-git
pkgver=0.1.0.r29.gd40e7e4
pkgrel=1
pkgdesc="Darkmatter: an Omarchy-themed Mattermost client"
arch=('x86_64' 'aarch64')
url="https://github.com/karstandsons/darkmatter"
license=('Apache-2.0')
# Linked: glibc, gcc-libs. Loaded at runtime: Wayland/X11, xkbcommon, and a GPU
# driver through Vulkan (it falls back to a CPU renderer without one).
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'wayland' 'hicolor-icon-theme')
makedepends=('cargo' 'git')
optdepends=(
  'vulkan-icd-loader: GPU rendering'
  'libx11: running under X11'
  'gnome-keyring: keep the login in a keyring (or any Secret Service)'
  'xdg-desktop-portal: file picker for attachments'
  'libnotify: mention notifications'
)
provides=('darkmatter')
conflicts=('darkmatter')
source=("darkmatter::git+${DARKMATTER_GIT:-file://$(realpath "$startdir/../..")}")
sha256sums=('SKIP')
options=('!lto' '!debug')  # cargo does its own (thin) LTO and strips

pkgver() {
  cd darkmatter
  printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd darkmatter
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd darkmatter
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p darkmatter
}

check() {
  cd darkmatter
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo test --frozen --release --workspace
}

package() {
  cd darkmatter
  install -Dm755 target/release/darkmatter "$pkgdir/usr/bin/darkmatter"
  install -Dm644 packaging/darkmatter.desktop "$pkgdir/usr/share/applications/darkmatter.desktop"
  install -Dm644 packaging/darkmatter.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/darkmatter.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/darkmatter/README.md"
}
